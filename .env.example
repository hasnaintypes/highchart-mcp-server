# Example environment variables
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Transport: "stdio" (default) or "http"
TRANSPORT=stdio

# --- Highcharts export (rendering) ---
# Base URL the export server fetches Highcharts scripts from.
# Leave unset to use the official CDN (https://code.highcharts.com/).
# For offline/dev, run `npm run seed:cache` (uses a local mirror of the
# installed highcharts package) instead of setting this.
# HIGHCHARTS_CDN_URL=https://code.highcharts.com/

# Where fetched Highcharts scripts are cached. Resolved RELATIVE to the
# highcharts-export-server package dir (node_modules/highcharts-export-server).
# Example: ../../.hc-cache places the cache at the repo root.
# HIGHCHARTS_CACHE_PATH=../../.hc-cache

# Re-fetch scripts on every start instead of using the cache ("true"/"false").
# HIGHCHARTS_FORCE_FETCH=false

# --- Monitoring / metrics ---
# Enable metrics collection + the GET /metrics endpoint (default true).
# METRICS_ENABLED=true
# Serve /metrics without auth once auth lands in 2.5 (default false).
# METRICS_PUBLIC=false
# Log a metrics snapshot every N ms on STDIO; 0 disables (default 0).
# METRICS_LOG_INTERVAL_MS=0

# --- Rendering robustness ---
# Abort a single chart export after this many ms (default 30000).
# EXPORT_TIMEOUT_MS=30000
# Number of concurrent export workers (default 2).
# EXPORT_MAX_WORKERS=2
# Max accepted HTTP request body size in bytes for /mcp (default 5000000).
# HTTP_MAX_BODY_BYTES=5000000

# --- Highcharts licensing ---
# Highcharts is free for non-commercial use with attribution (credits kept on).
# Commercial/production use requires a Highcharts license from https://highcharts.com.
# Record your license id here (also required before credits can be disabled).
# HIGHCHARTS_LICENSE_ID=
# Show the "Highcharts.com" credit on charts. Default true. Can only be set to
# false when HIGHCHARTS_LICENSE_ID is provided (otherwise forced to true).
# HIGHCHARTS_CREDITS_ENABLED=true
